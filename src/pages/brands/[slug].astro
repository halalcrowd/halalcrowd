---
import PlaceCard from "../../components/PlaceCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDirectoryData } from "../../lib/airtable";
import { placesForEntity } from "../../lib/content";
import { parseBrandDescription } from "../../lib/rich-text";

export async function getStaticPaths() {
  const data = await getDirectoryData();
  return data.brands.map((entity) => ({ params: { slug: entity.slug }, props: { entity, places: placesForEntity(data.places, "brands", entity.id) } }));
}

const { entity, places } = Astro.props;
const descriptionBlocks = parseBrandDescription(entity.description);
---

<BaseLayout title={entity.name} description={`Browse ${entity.placeCount} halal food outlets for ${entity.name} in Singapore.`}>
  <section class="container-page py-14" data-pagefind-body data-pagefind-meta={`brand:${entity.name}`}>
    <p class="eyebrow">Brand</p>
    <h1 class="editorial-title mt-5">{entity.name}</h1>
    <p class="mt-6 text-lg text-muted">{entity.placeCount} outlets across Singapore.</p>
  </section>
  {
    descriptionBlocks.length > 0 && (
      <section class="container-page pb-8">
        <article class="max-w-3xl border-y border-line py-10">
          {descriptionBlocks.map((block) => {
            if (block.type === "h1") {
              return <h2 class="font-display text-4xl font-semibold leading-tight text-ink sm:text-5xl">{block.text}</h2>;
            }
            if (block.type === "h2") {
              return <h3 class="mt-10 font-display text-3xl font-semibold leading-tight text-ink">{block.text}</h3>;
            }
            if (block.type === "h3") {
              return <h4 class="mt-8 text-xl font-semibold leading-snug text-ink">{block.text}</h4>;
            }
            return <p class="mt-5 text-lg leading-8 text-muted">{block.text}</p>;
          })}
        </article>
      </section>
    )
  }
  <section class="container-page py-8">
    <h2 class="section-title mb-6">Outlets</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {places.map((place) => <PlaceCard place={place} />)}
    </div>
  </section>
</BaseLayout>
