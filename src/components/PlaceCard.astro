---
import type { FoodPlace } from "../lib/types";

interface Props {
  place: FoodPlace;
  compact?: boolean;
}

const { place, compact = false } = Astro.props;
const brand = place.brands[0]?.name;
const neighbourhood = place.neighbourhoods[0];
const mall = place.malls[0];
const mrt = place.mrtStations[0];
---

<article class="group overflow-hidden border border-line bg-paper shadow-sm transition hover:-translate-y-0.5 hover:shadow-editorial">
  <a href={`/halal-food-places/${place.slug}`} class="focus-ring block">
    <div class={compact ? "aspect-[4/3] overflow-hidden bg-shell" : "aspect-[5/4] overflow-hidden bg-shell"}>
      <img
        src={place.imageUrl}
        alt={place.name}
        loading="lazy"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
    </div>
    <div class="p-5">
      <div class="flex flex-wrap items-center gap-2">
        {brand && <span class="text-xs font-semibold uppercase tracking-[0.16em] text-halal">{brand}</span>}
        {place.status && <span class="rounded-full bg-sage px-3 py-1 text-xs font-semibold text-halal">{place.status}</span>}
      </div>
      <h3 class="mt-3 font-display text-2xl font-semibold leading-tight text-ink">{place.name}</h3>
      <p class="mt-3 text-sm text-muted">
        {[neighbourhood?.name, mall?.name, mrt?.name].filter(Boolean).join(" · ")}
      </p>
      {place.category && <p class="mt-4 border-t border-line pt-4 text-sm font-medium text-ink">{place.category}</p>}
    </div>
  </a>
</article>
